#!/usr/bin/env bash
set -euo pipefail

since="10m"
profile=""

usage() {
	echo "Usage: awslogs [-p|--profile PROFILE] [-s|--since DURATION]" >&2
	exit 1
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-p|--profile)
			profile="$2"
			shift 2
			;;
		-s|--since)
			since="$2"
			shift 2
			;;
		-h|--help)
			usage
			;;
		*)
			usage
			;;
	esac
done

aws_args=()
if [[ -n "$profile" ]]; then
	aws_args+=(--profile "$profile")
fi

aws "${aws_args[@]+"${aws_args[@]}"}" logs list-log-groups | jq -r '.logGroups.[].logGroupName' | fzf | xargs -I {} aws "${aws_args[@]+"${aws_args[@]}"}" logs tail --follow {} --since "$since"
